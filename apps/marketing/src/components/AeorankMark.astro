---
interface Props {
	size?: number;
	class?: string;
}
const { size = 26, class: className = "" } = Astro.props;
---

<span class={`aeo-mark ${className}`} style={`--aeo-mark-size:${size}px`}>
	<svg
		width={size}
		height={size}
		viewBox="0 0 32 32"
		fill="none"
		aria-hidden="true"
	>
		<rect width="32" height="32" rx="7" fill="#0A0B0F"></rect>
		<path
			class="aeo-mark__arc aeo-mark__arc--outer"
			d="M6.943 23.133 A13.078 13.078 0 0 1 27.107 6.511"
			stroke="#3DFFB5"
			stroke-width="0.922"
			stroke-linecap="butt"></path>
		<path
			class="aeo-mark__arc aeo-mark__arc--inner"
			d="M10.039 20.800 A9.202 9.202 0 0 1 24.226 9.105"
			stroke="#3DFFB5"
			stroke-width="0.694"
			stroke-linecap="butt"></path>
		<circle class="aeo-mark__dot" cx="13.918" cy="13.333" r="1.425" fill="#3DFFB5"></circle>
		<polygon points="17.352,14.502 17.352,19.470 6.539,30.283 6.539,25.315" fill="#F2F2F3"></polygon>
		<polygon points="17.425,14.502 17.425,19.470 28.237,30.283 28.237,25.315" fill="#3DFFB5"></polygon>
	</svg>
</span>

<style>
	.aeo-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--aeo-mark-size, 26px);
		height: var(--aeo-mark-size, 26px);
		border-radius: calc(var(--aeo-mark-size, 26px) * 0.22);
		overflow: hidden;
		transition: box-shadow 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.aeo-mark svg {
		display: block;
		transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.aeo-mark__arc--outer {
		animation: aeo-mark-scan 2.8s ease-in-out infinite;
		transform-origin: 17.5px 15.3px;
	}
	.aeo-mark__arc--inner {
		animation: aeo-mark-scan 2.8s ease-in-out infinite 0.35s;
		transform-origin: 17.5px 15.3px;
	}
	.aeo-mark__dot {
		animation: aeo-mark-scan 2.8s ease-in-out infinite 0.18s;
	}

	@keyframes aeo-mark-scan {
		0%,
		100% {
			opacity: 0.72;
		}
		50% {
			opacity: 1;
		}
	}

	a:hover .aeo-mark,
	button:hover .aeo-mark,
	.aeo-mark--interactive:hover {
		box-shadow: 0 6px 18px rgba(61, 255, 181, 0.28);
	}

	a:hover .aeo-mark svg,
	button:hover .aeo-mark svg,
	.aeo-mark--interactive:hover svg {
		transform: scale(1.04);
	}

	a:active .aeo-mark svg,
	button:active .aeo-mark svg,
	.aeo-mark--interactive:active svg {
		transform: scale(0.93);
		transition-duration: 120ms;
	}

	@media (prefers-reduced-motion: reduce) {
		.aeo-mark__arc--outer,
		.aeo-mark__arc--inner,
		.aeo-mark__dot {
			animation: none;
			opacity: 1;
		}
		.aeo-mark svg,
		.aeo-mark {
			transition: none;
		}
		a:hover .aeo-mark svg,
		button:hover .aeo-mark svg,
		.aeo-mark--interactive:hover svg {
			transform: none;
		}
	}
</style>
